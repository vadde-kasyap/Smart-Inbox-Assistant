# Oracle Database
ORACLE_HOST=oracle
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=smart_inbox
ORACLE_PASSWORD=smart_inbox_secret
ORACLE_ROOT_PASSWORD=oracle_admin_secret

# Spring Boot Backend
BACKEND_PORT=8080
APP_STORAGE_PATH=/app/storage
MAILBOX_TYPE=mock
MAILBOX_MOCK_PATH=/app/test-data/emails
MAILBOX_POLL_CRON=0 */1 * * * *

# IMAP Mailbox (Used when MAILBOX_TYPE=imap)
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USERNAME=smartinbox@example.com
MAIL_PASSWORD=change_me
MAIL_FOLDER=INBOX
MAIL_SSL_ENABLE=true

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_MODEL_NAME=Qwen3-VL-2B-Instruct
